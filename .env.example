# ---- AI ENGINE (Phase 0/1) ----
# Leave empty = DEMO MODE (procedural backgrounds, everything still works)
# Set it and every banner is rendered by OpenAI gpt-image-2 at a native
# 1536x512 (true 3:1) — no cropping anywhere in the pipeline.
OPENAI_API_KEY=

# ---- SESSIONS ----
# Signs the wallet session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating it logs everyone out.
AUTH_SECRET=

# Set to 1 on a preview deploy to top up credits without real payments.
# Leave UNSET on the live site — with it on, credits are free.
NEXT_PUBLIC_ENABLE_TEST_CREDITS=

# ---- SOLANA / PAYMENTS (Phase 2) ----
# Your dedicated treasury wallet public address (NEVER a personal wallet)
NEXT_PUBLIC_TREASURY_WALLET=
# Helius webhook auth header value (you choose it when creating the webhook)
HELIUS_WEBHOOK_AUTH=
# Helius RPC url (for holder checks later)
HELIUS_RPC_URL=

# ---- FIREBASE (Phase 2) ----
# Client (safe to expose, hence NEXT_PUBLIC_)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Admin (server only — from a service account JSON, paste as one line)
FIREBASE_SERVICE_ACCOUNT_JSON=
